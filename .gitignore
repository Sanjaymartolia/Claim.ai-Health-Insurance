.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
# secrets: any env file, at any depth. Only the template (no real values) is tracked.
.env
.env.*
!.env.example
*.sqlite
*.db
chroma-data/
data/raw/
.claude/settings.local.json
# tool caches; runs/ plots are kept for reports
.index/
.cache/
.state/

# reference notebooks: they contain OpenRouter API keys; never commit.
# Upper or lower case, so a teammate on Linux or macOS with another spelling is covered too.
[Rr]eference_[Cc]ode_[Ff]iles/
# Jupyter's autosave copies keep any key the notebook had
.ipynb_checkpoints/
# DeepEval's local test-run cache (`deepeval test run`): it stores each test case's input and output
.deepeval/
# Office lock files (Word, Excel): created while a document is open; they hold the user's name
~$*
# Held-out eval cases and their gold answers (CLAUDE.md rule 5): never in a repository
data/claimsense-heldout/
eval/heldout/
