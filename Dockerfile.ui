# The adjudicator case UI (src/claimsense/ui/, ADR-0015). It is a client of the case API only:
# the image holds the package with its core dependencies and Streamlit, no agents and no data.
FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
# Pinned (docker/constraints-ui.txt, from the last working image), and pip's cache is kept between
# builds: a new PyPI release or a dropped connection does not force a download.
COPY docker/constraints-ui.txt /tmp/constraints.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --retries 10 --timeout 300 -c /tmp/constraints.txt ".[ui]"
EXPOSE 8501
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=2)"
# Inside the container the UI listens on every interface; compose publishes it on 127.0.0.1.
CMD ["python", "-m", "claimsense.ui", "--server.address", "0.0.0.0"]
